{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DynamoDBAccess",
            "Effect": "Allow",
            "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
                "dynamodb:Query",
                "dynamodb:Scan",
                "dynamodb:BatchGetItem",
                "dynamodb:BatchWriteItem",
                "dynamodb:DescribeTable"
            ],
            "Resource": [
                "arn:aws:dynamodb:ap-south-1:416964654377:table/Users",
                "arn:aws:dynamodb:ap-south-1:416964654377:table/Users/index/*",
                "arn:aws:dynamodb:ap-south-1:416964654377:table/Resources",
                "arn:aws:dynamodb:ap-south-1:416964654377:table/Resources/index/*",
                "arn:aws:dynamodb:ap-south-1:416964654377:table/Assessments",
                "arn:aws:dynamodb:ap-south-1:416964654377:table/Assessments/index/*",
                "arn:aws:dynamodb:ap-south-1:416964654377:table/Referrals",
                "arn:aws:dynamodb:ap-south-1:416964654377:table/Referrals/index/*",
                "arn:aws:dynamodb:ap-south-1:416964654377:table/Feedback",
                "arn:aws:dynamodb:ap-south-1:416964654377:table/Feedback/index/*",
                "arn:aws:dynamodb:ap-south-1:416964654377:table/Documents",
                "arn:aws:dynamodb:ap-south-1:416964654377:table/Documents/index/*"
            ]
        },
        {
            "Sid": "DynamoDBList",
            "Effect": "Allow",
            "Action": "dynamodb:ListTables",
            "Resource": "*"
        },
        {
            "Sid": "S3ObjectAccess",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::cana-verification-docs-416964654377/*"
        },
        {
            "Sid": "S3ListBucket",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::cana-verification-docs-416964654377"
        }
    ]
}